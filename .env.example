# Copy to .env (used by docker compose; for the plain binary export/pass the same variables).
# Every variable is optional.

# Listen address. Inside Docker keep 0.0.0.0:8080 and change only the published port in compose.
#JUDGEFLOW_ADDR=0.0.0.0:8080

# Where the SQLite DB, uploads and secret.key live (Docker image: /data).
#JUDGEFLOW_DATA_DIR=./data

# Base URL for judge/invite links and QR codes. Set it behind a tunnel/proxy or on a LAN:
#   https://judge.example.com   or   http://192.168.1.10:8080
# If unset, links are built from the request Host header.
#JUDGEFLOW_PUBLIC_URL=

# Key material for encrypting TOTP secrets. If unset, a random key is generated once
# into DATA_DIR/secret.key. Changing it later makes existing TOTP secrets unreadable.
#JUDGEFLOW_SECRET_KEY=

# Take the client IP (rate limiting) from CF-Connecting-IP / X-Forwarded-For. Set to true only
# behind a reverse proxy or Cloudflare Tunnel; otherwise clients could spoof their IP.
#JUDGEFLOW_TRUST_PROXY=false

# Log filter (tracing).
#RUST_LOG=info

# docker compose only: host port to publish (default 8080).
#HOST_PORT=8080
